{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LouisCaiKM7/himcm-o-paper-skill/main/templates/result_contract.schema.json",
  "title": "Result Contract",
  "description": "Immutable machine-readable outputs from one official model run.",
  "type": "object",
  "required": ["contract_version", "run_id", "model_id", "status", "results", "checks"],
  "properties": {
    "contract_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["VALID", "INVALID", "PARTIAL", "FAILED"]},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["result_id", "label", "value", "unit", "semantic_type"],
        "properties": {
          "result_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "value": {},
          "unit": {"type": "string"},
          "semantic_type": {"enum": ["POINT", "INTERVAL", "BOUND", "SCENARIO", "OPTIMUM", "FEASIBLE", "RANK", "RECOMMENDATION"]},
          "precision": {"type": ["integer", "null"], "minimum": 0},
          "population": {"type": ["string", "null"]},
          "time_scope": {"type": ["string", "null"]},
          "scenario": {"type": ["string", "null"]},
          "source_artifact": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "status", "evidence"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]},
          "evidence": {"type": "string"},
          "independence_level": {"type": "integer", "minimum": 1, "maximum": 5}
        },
        "additionalProperties": true
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
