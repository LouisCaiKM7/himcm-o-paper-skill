{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LouisCaiKM7/himcm-o-paper-skill/main/templates/run_manifest.schema.json",
  "title": "HiMCM run manifest",
  "type": "object",
  "required": ["run_id", "model_versions", "command", "environment", "input_hashes", "outputs", "exit_code"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "official": {"type": "boolean"},
    "model_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "command": {"type": "string", "minLength": 1},
    "environment": {"type": "object"},
    "input_hashes": {"type": "object", "minProperties": 1},
    "seeds": {"type": "array", "items": {"type": ["integer", "string"]}},
    "solver_status": {"type": ["string", "null"]},
    "tolerances": {"type": "object"},
    "started_at": {"type": ["string", "null"]},
    "finished_at": {"type": ["string", "null"]},
    "exit_code": {"type": "integer"},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "producer"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "producer": {"type": "string"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
