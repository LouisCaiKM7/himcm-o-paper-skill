{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LouisCaiKM7/himcm-o-paper-skill/main/templates/input_manifest.schema.json",
  "title": "Input Manifest",
  "description": "Inventory of every supplied or acquired input, including extraction and readability status.",
  "type": "object",
  "required": ["manifest_version", "files"],
  "properties": {
    "manifest_version": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role", "sha256", "bytes", "read_status"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["problem", "rules", "data", "source", "prior-art", "other"]},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string"},
          "pages_or_records": {"type": "integer", "minimum": 0},
          "read_status": {"enum": ["READ", "PARTIAL", "UNREADABLE", "NOT_APPLICABLE"]},
          "extraction_method": {"type": "string"},
          "unreadable_regions": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
