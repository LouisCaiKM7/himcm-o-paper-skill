{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LouisCaiKM7/himcm-o-paper-skill/main/templates/model_card.schema.json",
  "title": "HiMCM model card",
  "type": "object",
  "required": ["model_id", "version", "status", "purpose", "requirements_owned", "formulation", "assumptions", "parameters", "validation_plan", "uncertainty_plan", "failure_modes"],
  "properties": {
    "model_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "validation-only", "rejected", "superseded"]},
    "purpose": {"type": "string", "minLength": 1},
    "requirements_owned": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "system_boundary": {"type": "string"},
    "entities_and_indices": {"type": "array", "items": {"type": "string"}},
    "variables": {"type": "array", "items": {"type": "object"}},
    "formulation": {"type": "string", "minLength": 1},
    "objective": {"type": ["string", "null"]},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "object"}},
    "parameters": {"type": "array", "items": {"type": "object"}},
    "solver_or_algorithm": {"type": "string"},
    "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "uncertainty_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "fallback_conclusion": {"type": "string"}
  }
}
