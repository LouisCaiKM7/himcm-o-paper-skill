{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LouisCaiKM7/himcm-o-paper-skill/main/templates/contest_profile.schema.json",
  "title": "HiMCM contest profile",
  "type": "object",
  "required": ["contest", "year", "problem", "source_cutoff", "rules"],
  "properties": {
    "contest": {"type": "string", "minLength": 1},
    "year": {"type": "integer", "minimum": 1999},
    "problem": {"type": "string", "minLength": 1},
    "submission_deadline": {"type": ["string", "null"]},
    "source_cutoff": {"type": ["string", "null"]},
    "historical_reconstruction": {"type": "boolean"},
    "prior_solution_exposure": {"type": "boolean"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "topic", "requirement", "status", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "topic": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1},
          "status": {"enum": ["VERIFIED", "UNVERIFIED", "NOT_APPLICABLE"]},
          "source": {
            "type": "object",
            "required": ["title", "url_or_path", "access_date", "authority"],
            "properties": {
              "title": {"type": "string"},
              "url_or_path": {"type": "string"},
              "access_date": {"type": "string"},
              "authority": {"type": "string"}
            }
          },
          "enforcement": {"type": "string"}
        }
      }
    }
  }
}
